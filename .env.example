# Panel admin (/admin) — ver PROGRESS.md para el detalle de arquitectura.

# Contraseña compartida para entrar a /admin. Si no se define, se usa el
# default de src/lib/admin/session.ts (ADMIN_PASSWORD_DEFAULT) — cambiar
# esto antes de desplegar a producción.
ADMIN_PASSWORD=shiftstudio2026

# Secret para firmar la cookie de sesión del admin (HMAC). Si no se define,
# se usa un valor de desarrollo inseguro fijo — generar uno propio en
# producción, por ejemplo con: openssl rand -hex 32
ADMIN_SESSION_SECRET=dev-insecure-secret-change-me

# Backend real (Supabase) para src/lib/admin/repository.supabase.ts — ver
# PROGRESS.md. URL del proyecto (Settings → API → Project URL).
SUPABASE_URL=

# Service role key del proyecto (Settings → API → service_role secret).
# NO es la anon/publishable key: las tablas de proyectos/comentarios/
# archivos tienen RLS habilitada sin policies (default-deny), a propósito,
# porque la autorización real la hacen los route handlers de Next
# (/api/admin con sesión, /api/portal con token) — la anon key no
# alcanzaría para leer ni escribir nada ahí. Esta key SÍ bypassa RLS y es
# secreta: solo se usa server-side, nunca debe llegar al bundle de
# cliente ni commitearse con un valor real.
SUPABASE_SERVICE_ROLE_KEY=
